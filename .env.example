# Local Docker Compose PostgreSQL credentials.
POSTGRES_USER=schoolwise
POSTGRES_PASSWORD=

# API settings. JWT_SECRET must be a unique random value of at least 32 bytes.
DATABASE_URL=
MIGRATION_DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=SchoolWise
JWT_AUDIENCE=SchoolWise.Web
FRONTEND_ORIGINS=http://localhost:3000

# Cloudflare R2. Reserved for future upload integration; not currently consumed.
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Frontend build-time API endpoint.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Local development admin seed values.
ADMIN_EMAIL=admin@schoolwise.local
ADMIN_PASSWORD=
